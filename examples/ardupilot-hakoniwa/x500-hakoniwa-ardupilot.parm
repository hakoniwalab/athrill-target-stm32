# 2. the board: no IO coprocessor; then the FMU outputs are SERVO1-8 (RCOut: PWM:1-8), motors on SERVO1-4 (AUX1-4)
BRD_IO_ENABLE,0
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,36
# 3. the place: Hakoniwa Drone's x500 starts at 47.641468 N, 122.140165 W (declination 15.011 deg)
COMPASS_AUTODEC,0
COMPASS_DEC,0.264505349
# 4. no RC and no safety switch in the simulation; checks as in ArduPilot SITL (4.6 ARMING_CHECK 0 = 4.7 ARMING_SKIPCHK -1)
ARMING_SKIPCHK,-1
BRD_SAFETY_DEFLT,0
FS_THR_ENABLE,0

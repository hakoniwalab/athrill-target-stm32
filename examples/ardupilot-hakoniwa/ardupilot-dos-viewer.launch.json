{
  "version": "0.1",
  "defaults": {
    "env": {
      "prepend": {
        "lib_path": ["/usr/local/hakoniwa/lib"]
      }
    },
    "delay_sec": 2
  },
  "assets": [
    {
      "name": "athrill",
      "activation_timing": "before_start",
      "command": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/run.sh",
      "args": [
        "${ARDUPILOT_ELF}",
        "${HAKO_WS}/athrill-target-stm32/build-hakoniwa/athrill3",
        "${HAKO_WS}/hakoniwalab-athrill-device-dshot/build-stm32-inproc/libhako_sensor_device_inproc_motor.dylib",
        "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/viewer-extra.txt"
      ],
      "cwd": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa",
      "env": {
        "set": {
          "ATHRILL_DEVICE_DIR": "${HAKO_WS}/hakoniwalab-athrill-device-dshot",
          "HAKO_DRONE_ROOT": "${HAKO_WS}/hakoniwa-drone-pro-motor-status",
          "HAKO_AIRCRAFT_CONFIG_PATH": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/x500-athrill-ardupilot",
          "ATHRILL_OPTIONS": "--hakoniwa athrill --pdudef ${HAKO_WS}/hakoniwa-pdu-bridge-core/config/web_bridge_disturb/pdu/drone-disturb-visual-state.json"
        }
      },
      "delay_sec": 5
    },
    {
      "name": "web_bridge",
      "activation_timing": "before_start",
      "depends_on": ["athrill"],
      "command": "${HAKO_WS}/hakoniwa-pdu-bridge-core/build/hakoniwa-pdu-web-bridge",
      "args": [
        "--config-root", "config/web_bridge_disturb",
        "--node-name", "web_bridge_disturb_node1",
        "--delta-time-step-usec", "20000",
        "--enable-ondemand"
      ],
      "cwd": "${HAKO_WS}/hakoniwa-pdu-bridge-core",
      "stdout": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/logs/web_bridge.out",
      "stderr": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/logs/web_bridge.err",
      "delay_sec": 2
    },
    {
      "name": "viewer",
      "activation_timing": "after_start",
      "command": "python3",
      "args": ["tools/hako.py", "serve", "--port", "8000"],
      "cwd": "${HAKO_WS}/hakoniwa-threejs-drone",
      "stdout": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/logs/viewer.out",
      "stderr": "${HAKO_WS}/athrill-target-stm32/examples/ardupilot-hakoniwa/logs/viewer.err",
      "delay_sec": 1
    }
  ]
}
